# Database Configuration
# Get from Neon Postgres dashboard: https://neon.tech
DATABASE_URL=postgresql://user:password@host.neon.tech:5432/dbname?sslmode=require

# Qdrant Cloud Configuration
# Get from Qdrant Cloud dashboard: https://cloud.qdrant.io
# For local development, you can use a local Qdrant instance
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=./qdrant_storage
QDRANT_COLLECTION_NAME=physical_ai_textbook

# Google Gemini API Configuration
# Get from Google AI Studio: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI Configuration (optional, for backward compatibility)
# Get from OpenAI platform: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Cloud Translation API (optional)
# Get from Google Cloud Console: https://console.cloud.google.com
GOOGLE_CLOUD_API_KEY=

# JWT Configuration
# Generate with: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_key_here_minimum_32_characters
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here_minimum_32_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration
# Allow frontend origin (comma-separated for multiple origins)
CORS_ORIGINS=http://localhost:3000,https://your-site.github.io

# Environment
ENVIRONMENT=development

# Rate Limiting
RATE_LIMIT_ANONYMOUS=10
RATE_LIMIT_AUTHENTICATED=100
