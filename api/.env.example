# Database Configuration
# Get from Neon Postgres dashboard: https://neon.tech
DATABASE_URL=postgresql://user:password@host.neon.tech:5432/dbname?sslmode=require

# Qdrant Cloud Configuration
# Get from Qdrant Cloud dashboard: https://cloud.qdrant.io
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key

# OpenAI Configuration
# Get from OpenAI platform: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_openai_api_key

# Google Cloud Translation API
# Get from Google Cloud Console: https://console.cloud.google.com
GOOGLE_CLOUD_API_KEY=your_google_api_key

# JWT Configuration
# Generate with: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_key_here_minimum_32_characters
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here_minimum_32_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration
# Allow frontend origin (comma-separated for multiple origins)
CORS_ORIGINS=http://localhost:3000,https://your-site.github.io

# Environment
ENVIRONMENT=development

# Rate Limiting
RATE_LIMIT_ANONYMOUS=10
RATE_LIMIT_AUTHENTICATED=100
